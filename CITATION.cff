cff-version: 1.2.0
message: "If you use this dataset, please cite it as below."
type: dataset
title: "Iowa registered construction contractors"
abstract: "Every construction contractor registered with the State of Iowa under Iowa Code ch. 91C, compiled by Iowa's Best Contractors from the State of Iowa contractor registration record (Iowa Department of Inspections, Appeals, and Licensing). One row per registered business: name, owner name, trade, city, county, ZIP, home state, registration number, status, issue and expiry dates, phone and profile URL. Registration is not a license and not a quality rating. License: Public record (State of Iowa), not copyrightable: Feist v. Rural Telephone (1991). Method: https://contractiowa.com/methodology"
authors:
  - name: "Iowa's Best Contractors"
    website: "https://contractiowa.com"
version: "2026-09-21"
date-released: 2026-09-21
license: CC0-1.0
url: "https://contractiowa.com/methodology"
repository-code: "https://github.com/Iowa-Contractors/iowa-registered-contractors-data"
keywords:
  - "Iowa"
  - "contractors"
  - "construction"
  - "contractor registration"
  - "public records"
  - "Iowa Code 91C"
